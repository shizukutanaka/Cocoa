# Cocoa Environment Variables
# Copy this file to .env and configure with your actual values.
#
# This file lists ONLY variables actually read by the live app (main/api_server.py
# plus everything it imports). main/ is now exactly the 33 modules reachable
# from that entry point — the unreachable R&D modules and their env vars
# (STRIPE_API_KEY, DATABASE_URL, SECRET_KEY, ...) were deleted outright, so
# there are no settings here that do nothing.

# ============================================================================
# CRITICAL SECURITY SETTINGS — set these before any real deployment
# ============================================================================

# JWT signing key for auth_manager.py (access/refresh tokens). If unset, a
# random per-process key is generated: tokens are invalidated on every
# restart and won't validate across multiple workers/replicas. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COCOA_JWT_SECRET=

# 2FA (TOTP) encryption key for two_factor_auth.py. Required to use 2FA at
# all — setup_2fa()/enable_2fa() raise if this is unset (fails closed, no
# insecure default). Generate the same way as COCOA_JWT_SECRET.
COCOA_2FA_SECRET=

# Legacy bearer-token auth for a small number of endpoints in api_server.py.
# Fails closed when unset (that legacy path is simply disabled) — only set
# this if something in your deployment still depends on it.
API_SECRET_TOKEN=

# HMAC key redis_cache_manager.py uses to sign pickled (non-JSON-serializable)
# cache values before storing them, and to verify on read. Required if you
# run with Redis caching enabled and cache non-JSON-serializable objects;
# without it, signed-pickle values are rejected rather than trusted blindly.
COCOA_CACHE_HMAC_KEY=

# ============================================================================
# CORS
# ============================================================================

# Comma-separated list of allowed origins for the frontend. Defaults to the
# Vite/CRA dev-server ports (http://localhost:3000, http://localhost:5173)
# when unset, so local development needs no configuration. Set this to your
# real frontend origin(s) in production.
COCOA_CORS_ORIGINS=

# ============================================================================
# ADMIN BOOTSTRAP
# ============================================================================

# auth_manager.py creates a default admin account on first run unless this is
# set to "false". Leave COCOA_ADMIN_PASSWORD unset to have a random password
# generated and logged once (recommended); set it to choose the password
# yourself instead.
COCOA_CREATE_DEFAULT_ADMIN=true
COCOA_ADMIN_PASSWORD=

# ============================================================================
# DURABILITY (optional — default is fully in-memory)
# ============================================================================

# When set to a writable directory, EVERY in-memory store is snapshotted to
# <dir>/state.json -- accounts, credit balances and ledger, listings (including
# the purchased parameter payloads), carts, orders, wishlists, collections,
# commissions, licences, gift cards, referrals, saved searches, memberships,
# refunds, notifications and bundles. Restored at startup, written atomically
# every 30 seconds and on clean shutdown, so a restart or deploy no longer
# wipes the marketplace. The search index is NOT stored: it is rebuilt from the
# restored listings at startup. Files are written 0600 (the snapshot contains
# password hashes). Single-process deployments only, like the stores
# themselves -- and this is now ENFORCED: the first process takes an exclusive
# lock on the directory and a second one (e.g. `uvicorn --workers 2`) refuses
# to start rather than splitting accounts across workers and overwriting each
# other's snapshots. A snapshot that fails to decode, or whose credit balances
# disagree with their ledger, stops the server from starting (fail-closed)
# rather than silently opening with missing data. A directory written by the
# earlier accounts+money-only build is migrated automatically on first start.
#COCOA_STATE_DIR=/var/lib/cocoa

# ============================================================================
# AUTH TUNING (all optional — sane defaults shown)
# ============================================================================

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=15
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
MAX_BOOKMARKS=1000
MAX_FOLLOWING=2000

# Only relevant in a non-production debugging session: exposes the raw
# password-reset token in the API response instead of only emailing/logging
# it. Never set this to true in production.
COCOA_EXPOSE_RESET_TOKEN=false

# ============================================================================
# RATE LIMITING (main/rate_limiter.py — all optional, requests/minute)
# ============================================================================

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PURCHASE_PER_MINUTE=30

# ============================================================================
# MARKETPLACE LIMITS (main/avatar_marketplace.py — optional)
# ============================================================================

MAX_PRICE_CREDITS=10000000
MAX_GRANT_CREDITS=100000000

# Cap on the global download log (oldest entries discarded), like the existing
# per-user caps on orders and notifications. It matters most with
# COCOA_STATE_DIR set, because the whole log is re-encoded under the store lock
# on every snapshot: ~100k entries costs ~300ms of blocked requests and a ~10MB
# file, ~500k costs ~2.5s and ~49MB. Trimming never revokes a purchase --
# re-download rights come from a separate ownership index -- it only ages out
# old analytics and the oldest rows of a user's download history.
MAX_DOWNLOAD_LOG=100000

# Cap on retained ADJUDICATED moderation history (reports, applications,
# disputes). Items were never removed -- resolving one only flips its status --
# and unlike the download log these are free for any logged-in user to create,
# so the growth is user-driven. Only resolved/dismissed items are ever evicted:
# an unadjudicated report is never dropped, and a queue that exceeds this while
# still open stays visible rather than being trimmed away.
MAX_MODERATION_HISTORY=20000

# Cap on retained versions per listing (oldest discarded). Each version stores a
# full parameter payload -- the largest per-item blob in the system -- and the
# count was unbounded. Versions are informational history: no purchase or
# download resolves through them, so ageing the oldest out costs a changelog
# entry, not a customer's goods.
MAX_VERSIONS_PER_LISTING=50

# Cap on retained price history per listing (oldest discarded). Only genuine
# price changes are recorded, but a seller alternating 10 -> 11 -> 10 produces
# genuine changes indefinitely, so the only friction was the request rate limit.
# Buyers see recent price movement, which the newest entries carry.
MAX_PRICE_HISTORY=200

# Cap on the global tip log (oldest discarded). This is the display record only:
# balances and the credit ledger are separate, so trimming it never moves money.
MAX_TIPS=50000

# ============================================================================
# POSTGRESQL (main/database_manager.py — optional)
# ============================================================================
# Business data does not live here: the stores are in-memory, with optional
# JSON snapshot durability via COCOA_STATE_DIR above. Only a couple of
# api_server.py code paths touch this connection. Safe to leave at defaults.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cocoa_db
DB_USER=cocoa_user
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ============================================================================
# REDIS (main/redis_cache_manager.py — optional)
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# DOCKER COMPOSE ONLY (docker-compose.yml, read from a .env file at the repo
# root by Docker Compose itself -- not by the Python app directly)
# ============================================================================

# Grafana's admin account is reachable on a published port (3001) with no
# other auth in front of it -- docker-compose.yml requires this to be set
# (fails fast rather than falling back to a guessable default like "admin").
GRAFANA_ADMIN_PASSWORD=
